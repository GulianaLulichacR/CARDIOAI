# Entorno verificado de CARDIOAI (copie a .env)
# No versionar secretos reales.

ENVIRONMENT=development

# Clave de firma JWT. Genere una propia en producción.
SECRET_KEY=dev-only-change-me-cardioai-2026
ACCESS_TOKEN_MINUTES=480
REFRESH_TOKEN_DAYS=7

# Base de datos. Para el experimento reproducible se recomienda una base aparte.
DATABASE_URL=sqlite:///data/cardioai.db
# DATABASE_URL=sqlite:///data/experiment.db

# Administrador inicial
ADMIN_EMAIL=admin@cardioai.local
ADMIN_PASSWORD=Admin2026!
SEED_DEMO_DATA=true

# Orígenes del frontend
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000

# Umbrales operativos (NO validados clínicamente)
RISK_LOW_MAX=0.10
RISK_HIGH_MIN=0.25
PREDICTION_HORIZON_YEARS=10

# Entrenamiento
ML_TRIALS=8
ML_CV_FOLDS=3
DEMO_SEED=42

# Opcionales
MLFLOW_ENABLED=false
LLM_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
